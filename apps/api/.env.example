PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DB_SYNCHRONIZE=true
JWT_SECRET=replace-with-a-long-random-secret
WEB_ORIGIN=http://localhost:3000
LLM_PROVIDER=rules
